# =============================================================================
# Code Analysis Platform — Environment Configuration
# =============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=8000
OPEN_BROWSER=1

# Local Ollama LLM Configuration
QWEN_ENABLED=1
QWEN_BASE_URL=http://127.0.0.1:11434
QWEN_MODEL=qwen2.5-coder:3b-instruct-q8_0

# Optional External OpenAI-compatible LLM
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Docker Execution Sandbox
RUNNER_IMAGE=code-analysis-runner:latest

# Custom Model Checkpoint Directories (Optional overrides)
# CODEBERT_MODEL_DIR=models/codebert
# ASTNN_MODEL_DIR=models/astnn
# CLASSIFIER_MODEL_PATH=models/classifier/model.joblib
