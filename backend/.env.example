# Go Backend Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
APP_ENV=development

# SQLite Database & Backup
SQLITE_PATH=./data/code_analysis.db
BACKUP_DIR=./backups
BACKUP_INTERVAL_MINUTES=60

# Session & Cookie Security
# Set COOKIE_SECURE=true in production behind HTTPS
COOKIE_NAME=ca_session
CSRF_COOKIE_NAME=ca_csrf
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
SESSION_TTL_HOURS=24

# CORS (comma-separated origins allowed to send credentials)
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Rate Limiting (Brute-force protection)
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW_SECONDS=60

# Optional: HMAC pepper for session token hashing (recommended in production; set via env var, never hardcode)
SESSION_TOKEN_PEPPER=

# Compiler & Python AI Service Integration (Prompt 2)
COMPILER_SERVICE_URL=http://127.0.0.1:8000
COMPILER_RUN_PATH=/api/run
COMPILER_TIMEOUT_SECONDS=15
AI_SERVICE_URL=http://127.0.0.1:8001
AI_PREDICT_PATH=/api/models/predict
AI_TIMEOUT_SECONDS=20
MAX_CODE_BYTES=65536
PIPELINE_VERSION=v1

